{
	"name": "komika",
	"version": "0.0.0",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev:reader": "pnpm --filter @komika/reader dev",
