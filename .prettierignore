# Build output & deps
**/build
**/dist
**/.svelte-kit
**/node_modules
apps/server/target

# Local agent tooling state (worktrees can hold stale copies of anything).
.claude/

# Lockfiles / generated
pnpm-lock.yaml

# GraphQL SDL uses `//` header comments (house style); prettier's graphql
# parser only accepts `#`, so it errors on this file. Skip it.
packages/api/src/schema/*.graphql

# Exact bytes are part of hashed test baselines or recorded results.
apps/server/tests/postgres_golden/
apps/server/bench/results/

