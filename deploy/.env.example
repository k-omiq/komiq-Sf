# Copy to deploy/.env and edit for your host. All values have sane defaults.

# The host BROWSERS use to reach the stack. For local use keep "localhost".
# For a real deploy set your domain or public IP, e.g. komika.example.com or 203.0.113.4.
PUBLIC_HOST=localhost

# Published ports (host side). BOTH SERVER_PORT and SUWAYOMI_PORT are bound to
# 127.0.0.1 only. Suwayomi's admin API is unauthenticated; and Docker's DNAT
# bypasses the host firewall's filter/INPUT chain, so a 0.0.0.0 publish is NOT
# protected by host firewall rules and is reachable from containers in unrelated
# compose stacks on the same machine. Front them with a reverse proxy / tunnel.
# READER_PORT only applies when the `selfhost` compose profile is enabled
# (`./deploy.sh up --with-reader`); the reader container is off by default.
READER_PORT=8081
SERVER_PORT=8080
SUWAYOMI_PORT=4567

# CIDRs of trusted reverse proxies, comma-separated. The auth rate-limiter honours
# X-Forwarded-For / X-Real-IP ONLY when the socket peer matches one of these;
# otherwise it keys on the socket peer. Blank (the default) is correct and safe
# when nothing fronts the server.
#
# ONLY set this while SERVER_PORT is loopback-bound (it is, in docker-compose.yml).
# On a 0.0.0.0 publish, any direct client could forge X-Forwarded-For and skip the
# limiter entirely. The two settings must always move together.
#
# Behind a Cloudflare Tunnel this is NOT 127.0.0.1/32, even though cloudflared
# targets localhost:8080. With Docker's userland proxy enabled, docker-proxy
# re-originates the connection from the bridge GATEWAY, so the server's peer is
# e.g. 172.21.0.1. Get the real value with:
#   docker network inspect komika_komika -f '{{json .IPAM.Config}}'
# Use the gateway /32, not the whole /16 — sibling containers are not proxies.
# Getting this wrong is silent: XFF is discarded and EVERY request keys to one
# address, so all users share a single rate-limit bucket and 10 failed logins
# lock out login + registration for everyone.
#   e.g.  TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.21.0.1/32
TRUSTED_PROXY_CIDRS=

# Base URL of your deployed Cloudflare image Worker (apps/worker). Browser images
# route through it (the reader ships in proxy mode). REQUIRED for images to load;
# leave blank only if you serve images another way. e.g. https://img.example.com
KOMIKA_IMG_WORKER_URL=

# Public origin of THIS server, used to build Suwayomi-source cover/page image URLs
# (the server proxies /api/v1/manga/... from the loopback-only Suwayomi). Set it to
# the public API origin the browser + image Worker can reach — e.g. https://api.komiq.cc
# behind a Cloudflare Tunnel. Defaults to http://<PUBLIC_HOST>:<SERVER_PORT> when
# blank (fine when you publish 8080 directly). It must NOT include Suwayomi's :4567
# port — that is loopback-only. The image Worker's ALLOWED_SOURCE_HOSTS must include
# this host for Suwayomi-source PAGE images to proxy (apps/worker/wrangler.toml).
SUWAYOMI_PUBLIC_URL=

# Admin account for the Komika "manga DB" console. The server provisions this
# account at startup (creates it from KOMIKA_ADMIN_PASSWORD if missing, else
# promotes it); these usernames are reserved from open registration.
KOMIKA_ADMIN_USERS=admin
# Quote the password — deploy.sh shell-sources this file, so spaces or shell
# metacharacters in an unquoted value would break sourcing.
KOMIKA_ADMIN_PASSWORD="change-this-admin-pw"
KOMIKA_ADMIN_EMAIL=admin@example.com

# How often (seconds) the adaptive scanner re-evaluates the library for updates.
SCAN_TICK_SECONDS=300

# Comma-separated MangaDex series titles to auto-add to the library on bootstrap,
# so the catalog is populated and the scanner has things to keep updated.
# Leave empty to start with an empty library (users/admin can add series later).
# Quoted: the titles contain spaces and deploy.sh shell-sources this file.
SEED_SERIES="Chainsaw Man,Solo Leveling,One Piece,Jujutsu Kaisen,The Eminence in Shadow"

TZ=UTC

# --- Continuous backup (Litestream → S3-compatible; Cloudflare R2) ----------
# Leave BLANK to run without backup. To enable: create a Cloudflare R2 bucket
# (S3-compatible) and an API token with Object Read & Write, then fill these in.
# Any S3-compatible store works (the vars are storage-agnostic); R2 is the
# reference target. On a fresh host the server restores the latest snapshot
# automatically before starting; while running it streams the WAL (point-in-time
# restore, ~seconds RPO).
# LITESTREAM_BUCKET=komika-backup
# LITESTREAM_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   # R2 S3 endpoint
# LITESTREAM_REGION=auto                                            # R2 has no regions
# LITESTREAM_ACCESS_KEY_ID=your-r2-access-key-id
# LITESTREAM_SECRET_ACCESS_KEY=your-r2-secret-access-key

# --- Canonical catalogue sync (direct MangaDex; CATALOGUE.md) ---------------
# OFF by default — nothing hits MangaDex unless CATALOGUE_SYNC is turned on.
# Enabling it makes the server CRAWL MangaDex on a schedule. The rate limiter is
# IN-PROCESS (it bounds one server process, not the fleet), so exactly ONE
# replica may run with CATALOGUE_SYNC=on — running it on multiple replicas
# multiplies the effective request rate against MangaDex's shared per-IP ceiling
# and risks a 429/403 ban (CATALOGUE.md, "Single-replica constraint (M4)"). If
# you enable it, set a descriptive MANGADEX_USER_AGENT per MangaDex API etiquette.
# Accepts on/1/true to enable; default off.
# CATALOGUE_SYNC=on
# User-Agent sent on every MangaDex request (required by their API). Make it
# descriptive/identifiable. Default: Komika/0.1 (+https://github.com/komika)
# MANGADEX_USER_AGENT="Komika/0.1 (+https://github.com/komika)"
# Interval (seconds) between recurring incremental catalogue/chapter refresh
# cycles; the first cycle seeds on startup. Must be > 0. Default 21600 (6h).
# CATALOGUE_SYNC_INTERVAL_SECS=21600
# Compute a cover perceptual-hash per work during the sync, used for dedup
# (CATALOGUE.md §4). Opt-in ON TOP of CATALOGUE_SYNC — it adds one cover download
# per work. Accepts on/1/true to enable; default off.
# COVER_PHASH=on
