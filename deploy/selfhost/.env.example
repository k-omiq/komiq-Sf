# komiq self-host settings. Everything is optional: without a .env file the
# defaults below apply. To change one, `cp .env.example .env`, edit, then
# `docker compose up -d` again.
#
# Accounts, sign-up, sources and internet access are not set here. They are
# chosen in the setup screens and in the admin console.

# Port on this machine. komiq answers at http://<this machine>:<port>/
KOMIQ_PORT=8080

# Who can reach that port.
#   0.0.0.0    every device that can reach this machine (your home network)
#   127.0.0.1  this machine only (a VPS behind a Cloudflare Tunnel)
KOMIQ_BIND=0.0.0.0

# Extra ports for internet access. install.sh chooses these for you.
# Local or Cloudflare Tunnel: leave COMPOSE_FILE unset (the default).
# Cloudflare public IP: publish HTTPS on port 443.
#   COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# Public without a domain: also publish port 80 for Let's Encrypt checks.
# Keep port 80 open: certificates are checked again every few days.
#   COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml:docker-compose.acme.yml

# Time zone for logs.
TZ=UTC

# Cloudflare challenge solver, for sources that show a "checking your browser"
# page. To turn it on, set both lines:
#   COMPOSE_PROFILES=flaresolverr
#   FLARESOLVERR_ENABLED=true
COMPOSE_PROFILES=
FLARESOLVERR_ENABLED=false
