# komiq self-host settings. Run install.sh to generate the required database
# password. For a manual install, replace the empty value on the existing line.
# Use only letters, digits, _, . or -. Run chmod 600 .env before starting Compose.
# Never change it on an existing PostgreSQL volume.
KOMIQ_DB_PASSWORD=

# Optional image tag.
# KOMIQ_IMAGE=komiq-selfhost:local
#
# Accounts, sign-up, sources and internet access are not set here. They are
# chosen in the setup screens and in the admin console.

# Port on this machine. komiq answers at http://<this machine>:<port>/
KOMIQ_PORT=8080

# Who can reach that port.
#   0.0.0.0    every device that can reach this machine (your home network)
#   127.0.0.1  this machine only (a VPS behind a Cloudflare Tunnel)
KOMIQ_BIND=0.0.0.0

# Extra ports for internet access. install.sh chooses these for you.
# Local or Cloudflare Tunnel: leave COMPOSE_FILE unset (the default).
# Cloudflare public IP: publish HTTPS on port 443.
#   COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# Public without a domain: also publish port 80 for Let's Encrypt checks.
# Keep port 80 open: certificates are checked again every few days.
#   COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml:docker-compose.acme.yml

# Time zone for logs.
TZ=UTC

# Cloudflare challenge solver, for sources that show a "checking your browser"
# page. To turn it on, set both lines:
#   COMPOSE_PROFILES=flaresolverr
#   FLARESOLVERR_ENABLED=true
COMPOSE_PROFILES=
FLARESOLVERR_ENABLED=false

# Send the engine's requests to sources through Cloudflare WARP, for sources
# that block this machine's address (common on a VPS). Starting it accepts
# Cloudflare's WARP terms. To turn it on, set both lines:
#   COMPOSE_PROFILES=warp
#   WARP_ENABLED=true
# With FlareSolverr as well: COMPOSE_PROFILES=flaresolverr,warp
WARP_ENABLED=false

# Cloudflare Turnstile, a browser check on sign-up, sign-in, password changes,
# comments, reviews and reports. Only for a server reached through Cloudflare on
# a domain you list in the widget. The native apps cannot show the check, so
# their users then sign in and post on the website. To turn it on, create a
# widget in the Cloudflare dashboard and set all three lines:
#   KOMIKA_TURNSTILE=on
#   KOMIKA_TURNSTILE_SITE_KEY=<site key>
#   KOMIKA_TURNSTILE_SECRET=<secret key>
KOMIKA_TURNSTILE=off
