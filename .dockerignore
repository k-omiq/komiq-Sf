# Keep the Docker build context small & reproducible. The server and reader
# Dockerfiles copy source + lockfiles and build from scratch, so none of the
# local build artifacts, deps, or archives belong in the context.
# Credential-bearing files (env files, backups, worker secrets) must never
# enter the build context — the reader image does `COPY . .` at build time.
**/node_modules
**/build
**/dist
**/.svelte-kit
apps/server/target
.git
*.zip
*.sqlite3
*.sqlite3-*
.env
**/.env
.env.*
**/.env.*
*.bak
**/*.bak
.dev.vars
**/.dev.vars
.wrangler
**/.wrangler

# Private self-host backups and installer state (context is the repository root).
*.dump
**/*.dump
*.tgz
**/*.tgz
deploy/selfhost/backups
deploy/selfhost/.sqlite-image-*
deploy/selfhost/.env*
**/.dump.*
# Local agent worktrees and settings are not image inputs.
.claude
.codex
.agents
.aws
