# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.svelte-kit/
.output/

# tauri / rust
target/
# gen/android is the Android Studio project and is tracked: it holds hand edits (app
# icons, the cleartext switch in app/build.gradle.kts) and has its own .gitignore files
# for build output. The rest of gen/ (apple, schemas) is regenerated.
apps/reader/src-tauri/gen/*
!apps/reader/src-tauri/gen/android/

# env & secrets
.env
.env.*
!.env.example
.dev.vars

# deployment access metadata (VPS host, SSH user, key path)
.credmanager.json

# e2e (playwright) + cloudflare worker
e2e/playwright-report/
e2e/test-results/
.wrangler/

# os / editor
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/

merge_plan.json

merge_review.json

merge-suwayomi-duplicates.done.log

# Local agent tooling state (worktrees can hold stale copies of anything).
.claude/worktrees/

# python bytecode
__pycache__/
*.pyc

# Planning documents, reviews, gate records and reports on work in progress
# stay local. The repository holds the source and its documentation
# (apps/docs, published at docs.komiq.cc).
docs/plans/
docs/audits/
docs/reviews/
docs/superpowers/
docs/2026-09-17-credential-storage-security-review.md
docs/ui-functional-regressions.md
/NATIVE_ENGINE_STATUS_*.md
/PERFORMANCE_ROADMAP.md
/.native-*.json
/SPEC.md
/CATALOGUE.md
/PRODUCTION.md
deploy/GO-LIVE.md
deploy/CLOUDFLARE-RUNBOOK.md
apps/server/tests/postgres_golden/VALIDATION.md

# Tools and experiments of the finished move to PostgreSQL stay local too.
deploy/spikes/
scripts/postgres-port-*.py
scripts/postgres-golden-dates.py
scripts/postgres-search-parity.py
scripts/postgres-test-fixtures.py
scripts/postgres-baseline-check.py
