# Reader build-time public config — PRODUCTION (committed, non-secret).
#
# Loaded (on top of `.env`) by the DEFAULT web build — `pnpm --filter @komika/reader
# build`, which targets Cloudflare edge SSR (adapter-cloudflare). Vite inlines these
# PUBLIC_* values via `$env/static/public` (see src/lib/config.ts), so they resolve at
# edge module scope where the request-time `$env/dynamic/public` is empty.
#
# These are the LIVE komiq.cc endpoints (all public, non-secret URLs). Only the vars
# that differ from the dev `.env` are listed; the rest inherit from `.env`.
#
# NOTE: the self-host Docker image (deploy/reader.Dockerfile) and Tauri DEV do NOT use
# these — Docker's build-args override them, and `tauri dev` runs in development mode.
PUBLIC_KOMIKA_BACKEND=on
PUBLIC_KOMIKA_BACKEND_KIND=komika
PUBLIC_KOMIKA_API=https://api.komiq.cc/graphql
PUBLIC_KOMIKA_IMG_MODE=proxy
PUBLIC_KOMIKA_IMG_WORKER=https://img.komiq.cc
