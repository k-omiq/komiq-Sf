# Reader build-time public config — DEV DEFAULTS (committed, non-secret).
#
# Consumed by `$env/static/public` (see src/lib/config.ts). Vite loads this file
# in EVERY mode, so it is the baseline that guarantees every PUBLIC_* import
# resolves (a missing `$env/static/public` export is a hard build error). More
# specific sources override it:
#   • `.env.production`          → the default web `pnpm build` (Cloudflare edge SSR)
#   • real env vars / Docker ARG → highest priority (deploy/reader.Dockerfile)
#   • `.env.local` (gitignored)  → your personal machine overrides
#
# Values here point at a LOCAL dev backend; they degrade to empty feeds when no
# local server is running. To customise without dirtying the tree, use `.env.local`.
PUBLIC_KOMIKA_BACKEND=on
PUBLIC_KOMIKA_BACKEND_KIND=komika
PUBLIC_KOMIKA_API=http://localhost:8080/graphql
PUBLIC_KOMIKA_IMG_MODE=direct
PUBLIC_KOMIKA_IMG_WORKER=http://localhost:8787
PUBLIC_SUWAYOMI_URL=http://localhost:4567
# Exact media route origins the hosted web reader may load page objects from
# (comma-separated, e.g. https://api.komiq.cc). Empty = load page sourceUrls as before.
PUBLIC_KOMIKA_MEDIA_HOSTS=
