# Generated by Cargo
/target/
/gen/schemas

# Bundle inputs produced by scripts/prepare-bundle.sh, never committed:
# the komika-server sidecar (binaries/komika-server-<target-triple>) and the
# embedded web builds the server serves (web/reader, web/admin).
# web/.gitkeep IS tracked so the bundle.resources dir exists on a fresh checkout.
/binaries/
/web/*
!/web/.gitkeep
