# Security headers for the admin console Worker (admin.komiq.cc).
#
# The Rust API's X-Frame-Options/nosniff layer only covers the API origin — this
# static SPA is served by Cloudflare Workers Assets, which sends nothing of its own.
# `_headers` is copied verbatim into build/ by adapter-static and applied at the edge.
#
# There is no XSS sink in the app today (no {@html}, innerHTML or eval anywhere), so
# this is defence-in-depth around a console that keeps a bearer token in localStorage.
#
# SvelteKit generates a hash-based CSP meta policy in the fallback HTML.
# That policy excludes unsafe-inline scripts. This complementary response header
# retains its bootstrap allowance because CSP policies intersect: the generated
# hashes would otherwise also have to be duplicated into this static header.
# Theme initialization is external (/theme-init.js), authorized by self.
# frame-ancestors remains a response header (meta policies cannot enforce it).
#
# connect-src pins the GraphQL API baked in at build time (PUBLIC_KOMIKA_API).
# challenges.cloudflare.com (script and frame) is the Turnstile widget, shown on the
# sign-in, password and user pages when the API asks for the check.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:; connect-src 'self' https://api.komiq.cc; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
