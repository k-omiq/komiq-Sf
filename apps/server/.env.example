# Komika unified server configuration.
PORT=8080
DATABASE_URL=sqlite://komika.sqlite3
SUWAYOMI_URL=http://localhost:4567
# Public base for image URLs handed to the browser (covers/pages). Behind Docker,
# federation uses the internal SUWAYOMI_URL but images must use a browser-reachable
# host. Defaults to SUWAYOMI_URL when unset.
# SUWAYOMI_PUBLIC_URL=http://your-host:4567
# Optional: pin a Suwayomi source id (otherwise an English source is auto-picked).
# SUWAYOMI_SOURCE_ID=
# Comma-separated CORS origins (reader dev + preview + tauri).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://tauri.localhost
# RUST_LOG=komika_server=debug
