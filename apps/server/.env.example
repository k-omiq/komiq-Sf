# Komika unified server configuration.
PORT=8080
# Listener address. 127.0.0.1 keeps the server private to this machine.
# BIND_ADDR=0.0.0.0
DATABASE_URL=sqlite://komika.sqlite3
SUWAYOMI_URL=http://localhost:4567
# Public base for image URLs handed to the browser (covers/pages). Behind Docker,
# federation uses the internal SUWAYOMI_URL but images must use a browser-reachable
# host. Defaults to SUWAYOMI_URL when unset.
# SUWAYOMI_PUBLIC_URL=http://your-host:4567
# Optional: pin a Suwayomi source id (otherwise an English source is auto-picked).
# SUWAYOMI_SOURCE_ID=
# Comma-separated CORS origins (reader dev + preview + tauri).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://tauri.localhost
# RUST_LOG=komika_server=debug

# Refresh stores and update installed Suwayomi extensions every 6h, including at boot.
# Set to 0 to disable automatic updates.
EXTENSION_AUTO_UPDATE_INTERVAL_SECONDS=21600

# Reserved admin usernames (default admin); never granted through registration.
# KOMIKA_ADMIN_USERS=admin
# Bootstrap a missing account, or prove an existing non-admin's current password
# before promotion. Existing admins are never re-passworded. Remove after use.
# KOMIKA_ADMIN_PASSWORD=
# Newly issued admin sessions are capped at 8h even when regular sessions last longer.
# SESSION_TTL_SECS=2592000

# Self-host. Each setting below reads env first, then the admin-changed value, then
# the default; set it here to pin it. With no admin account at all, the server prints
# a one-time setup code to the log at boot for the first-run screen (createOwner).
# KOMIKA_INSTANCE_NAME=komiq
# Sign-up. Unset: open, or closed when KOMIKA_WEB_DIR is set (a self-hosted install).
# KOMIKA_REGISTRATION_OPEN=true
# Tell reader apps to fetch chapter pages from the sources themselves. An app that has
# its own source engine then offers no "fetch through the server" choice. The web
# reader and apps without an engine still read through this server. Default: off.
# KOMIKA_APPS_FETCH_THEMSELVES=on
# Serve built web apps from this folder: reader/ at /, admin/ at /admin.
# KOMIKA_WEB_DIR=/srv/komika-web
