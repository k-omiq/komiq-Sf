# Security headers for the docs Worker (docs.komiq.cc). adapter-static copies this
# file into build/ and Workers Assets applies it at the edge.
#
# SvelteKit writes a hash-based CSP meta tag into every prerendered page. CSP
# policies intersect, so this header keeps `unsafe-inline` for scripts (the hashes
# would otherwise have to be repeated here) and adds what a meta tag cannot set.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
